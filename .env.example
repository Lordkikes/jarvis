# Cerebro (obligatorio)
ANTHROPIC_API_KEY=sk-ant-...

# Voz (opcional, solo si usas estos proveedores)
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
PICOVOICE_ACCESS_KEY=

# Correo (solo si activas sources.email en config.yaml)
# Con Gmail: contraseña de aplicación, no la de tu cuenta
JARVIS_EMAIL_PASSWORD=

# Redes sociales (solo si activas esas fuentes en config.yaml)
# Bluesky: Ajustes → App Passwords. Nunca la contraseña de tu cuenta.
JARVIS_BLUESKY_APP_PASSWORD=
# Mastodon: Preferencias → Desarrollo → Nueva aplicación, permiso `read`
JARVIS_MASTODON_TOKEN=

# Reddit: crea una aplicación «script» en https://www.reddit.com/prefs/apps
# La contraseña solo sirve si la cuenta no tiene verificación en dos pasos.
JARVIS_REDDIT_CLIENT_ID=
JARVIS_REDDIT_CLIENT_SECRET=
JARVIS_REDDIT_PASSWORD=

# Herramientas (opcional)
OPENWEATHER_API_KEY=
JARVIS_CITY=Madrid
